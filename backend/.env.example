# Used when the API runs inside Docker Compose (service hostname = postgres / redis).
# For local `npm run dev` against docker-compose.dev.yml, use localhost ports instead:
#   DATABASE_URL=postgresql://hollow:changeme@localhost:5433/hollow
#   REDIS_URL=redis://localhost:6380

DATABASE_URL=postgresql://hollow:changeme@postgres:5432/hollow
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_a_long_random_string
PORT=4000

# Comma-separated emails allowed to view the /admin stats dashboard.
# Leave empty to disable the admin surface entirely.
ADMIN_EMAILS=you@example.com

# Optional production CORS allowlist (comma-separated origins). Empty = allow all.
# CORS_ORIGIN=https://notes.example.com
