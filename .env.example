# Production secrets for docker compose (copy to repo root as `.env`).
# Never commit the real `.env`.

# Strong random strings — generate with: openssl rand -hex 32
# Prefer hex (no @ # : etc.) so DB URLs stay valid.
POSTGRES_PASSWORD=change_me_to_a_long_random_password
JWT_SECRET=change_me_to_another_long_random_secret

# Optional: dedicated AES key for encrypting page/note/task bodies at rest.
# Prefer a separate 64-char hex so you can rotate JWT_SECRET without losing data.
# CONTENT_ENCRYPTION_KEY=

# Optional: comma-separated emails for the admin stats dashboard
ADMIN_EMAILS=you@example.com

# Optional: restrict browser CORS to your public origin(s), comma-separated.
# Leave empty to allow all origins (fine behind Cloudflare Tunnel on one domain).
# CORS_ORIGIN=https://notes.example.com

# Host port published by Nginx (Cloudflare Tunnel / reverse proxy points here)
HOST_PORT=8080
