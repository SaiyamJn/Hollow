    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:init": "npx eas-cli@latest init",
    "apk:local": "expo prebuild --platform android && expo run:android --variant release",
    "apk:local:gradle": "expo prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "build:android": "npx eas-cli@latest build --profile production --platform android",
    "build:apk": "npx eas-cli@latest build --profile preview --platform android",
    "build:android:local": "npx eas-cli@latest build --profile production --platform android --local",
    "build:ios": "npx eas-cli@latest build --profile production --platform ios",
    "build:production": "npx eas-cli@latest build --profile production --platform all",
    "submit:android": "npx eas-cli@latest submit --platform android --latest --profile production"
  },
  "private": true
}
