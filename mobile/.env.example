# Backend URL for the mobile app (same Postgres / user accounts as the web app).
#
# Local backend (Expo Go on LAN):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
#
# Production Hollow (Docker + Nginx) — must end with /api:
#   EXPO_PUBLIC_API_URL=http://203.192.206.63/api
#   EXPO_PUBLIC_API_URL=https://notes.example.com/api
#
# Leave unset during local Expo Go if Metro and the backend share a host —
# the app then derives http://<metro-host>:4000 automatically.
#
# EAS Build (expo.dev): set the same value in mobile/eas.json under
# build.<profile>.env.EXPO_PUBLIC_API_URL (env is baked into the binary).
EXPO_PUBLIC_API_URL=
