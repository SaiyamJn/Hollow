generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  name         String
  notebooks    Notebook[]
  quickNotes   QuickNote[]
  tasks        Task[]
  authSessions AuthSession[]
  createdAt    DateTime      @default(now())
}

/// One row per login — JWT carries sid so devices can be listed and revoked.
model AuthSession {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  deviceName String
  platform   String
  client     String
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
}

model Notebook {
  id           String    @id @default(uuid())
  title        String
  owner        User      @relation(fields: [ownerId], references: [id])
  ownerId      String
  isLocked     Boolean   @default(false)
  passwordHash String?
  salt         String?
  sections     Section[]
  createdAt    DateTime  @default(now())

  @@index([ownerId])
}

model Section {
  id           String   @id @default(uuid())
  title        String
  notebook     Notebook @relation(fields: [notebookId], references: [id])
  notebookId   String
  isLocked     Boolean  @default(false)
  passwordHash String?
  salt         String?
  pages        Page[]
  createdAt    DateTime @default(now())

  @@index([notebookId])
}

// content is plain markdown/JSON blocks when the section is unlocked,
// or an AES-256-GCM ciphertext (base64) when the section is locked.
model Page {
  id            String        @id @default(uuid())
  title         String
  content       String        @default("")
  section       Section       @relation(fields: [sectionId], references: [id])
  sectionId     String
  tags          Tag[]         @relation("PageTags")
  outgoingLinks PageLink[]    @relation("SourcePage")
  incomingLinks PageLink[]    @relation("TargetPage")
  docState      PageDocState?
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())

  @@index([sectionId])
  @@index([updatedAt])
}

// Snapshot of the Yjs CRDT state for realtime collaboration, encoded as
// base64. Encrypted with the section key (same AES-256-GCM scheme as Page
// content) when the section is locked.
model PageDocState {
  pageId    String   @id
  page      Page     @relation(fields: [pageId], references: [id])
  state     String
  updatedAt DateTime @updatedAt
}

// Obsidian-style [[links]] between pages, used for backlinks + graph view
model PageLink {
  id           String @id @default(uuid())
  sourcePage   Page   @relation("SourcePage", fields: [sourcePageId], references: [id])
  sourcePageId String
  targetPage   Page   @relation("TargetPage", fields: [targetPageId], references: [id])
  targetPageId String

  @@index([sourcePageId])
  @@index([targetPageId])
}

// Google Keep-style quick notes, separate from the notebook hierarchy
model QuickNote {
  id        String    @id @default(uuid())
  /// Optional sealed title (notes + lists)
  title     String    @default("")
  content   String
  /// note = free text; list = checklist (title field + items)
  kind      String    @default("note")
  /// Sealed JSON: [{ id, text, done }] when kind = list
  items     String?
  color     String    @default("gray")
  pinned    Boolean   @default(false)
  archived  Boolean   @default(false)
  /// Higher = nearer the top within pinned / unpinned groups
  sortOrder Int       @default(0)
  /// Soft-delete — purged permanently 7 days after this timestamp
  deletedAt DateTime?
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([ownerId, deletedAt])
}

// Google Tasks-style tasks, with subtasks and optional due dates
model Task {
  id           String    @id @default(uuid())
  title        String
  description  String    @default("")
  done         Boolean   @default(false)
  starred      Boolean   @default(false)
  dueAt        DateTime?
  /// daily | weekly | monthly | yearly — only meaningful when dueAt is set
  repeatRule   String?
  /// JSON array of weekdays 0=Sun…6=Sat when weekly (e.g. "[1,3,5]")
  repeatDays   String?
  /// Every N units of repeatRule (default 1)
  repeatInterval Int       @default(1)
  /// never | on | after — null treated as never
  repeatEnd    String?
  /// End date when repeatEnd = on
  repeatUntil  DateTime?
  /// Remaining occurrences (incl. current) when repeatEnd = after
  repeatCount  Int?
  owner        User      @relation(fields: [ownerId], references: [id])
  ownerId      String
  parentTask   Task?     @relation("SubTasks", fields: [parentTaskId], references: [id])
  parentTaskId String?
  subtasks     Task[]    @relation("SubTasks")
  createdAt    DateTime  @default(now())

  @@index([ownerId, parentTaskId])
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  pages Page[] @relation("PageTags")
}
