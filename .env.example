# Production secrets for docker compose (copy to repo root as `.env`).
# Never commit the real `.env`.

# Strong random strings — generate with: openssl rand -hex 32
# Prefer hex (no @ # : etc.) so DB URLs stay valid.
POSTGRES_PASSWORD=change_me_to_a_long_random_password
JWT_SECRET=change_me_to_another_long_random_secret

# Required for creating pages / notes / tasks (encrypts bodies at rest).
# Use a dedicated 64-char hex so you can rotate JWT_SECRET later without losing data.
CONTENT_ENCRYPTION_KEY=change_me_to_a_third_long_random_secret

# Admin console (/admin/login) — separate from normal user accounts.
# Password must be at least 8 characters. Leave empty to disable admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_admin_password

# Optional: restrict browser CORS to your public origin(s), comma-separated.
# Leave empty to allow all origins (fine behind Cloudflare Tunnel on one domain).
# CORS_ORIGIN=https://notes.example.com

# Host port published by Nginx.
# Use 80 if that port is forwarded to this machine (public IP access).
# Use 8080 for LAN-only / Tailscale / tunnel to localhost:8080.
HOST_PORT=80
