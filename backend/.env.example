# Used when the API runs inside Docker Compose (service hostname = postgres / redis).
# For local `npm run dev` against docker-compose.dev.yml, use localhost ports instead:
#   DATABASE_URL=postgresql://hollow:changeme@localhost:5433/hollow
#   REDIS_URL=redis://localhost:6380

DATABASE_URL=postgresql://hollow:changeme@postgres:5432/hollow
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_a_long_random_string
# Optional dedicated key for AES-256 content-at-rest (64-char hex preferred).
# If unset, a key is derived from JWT_SECRET — keep JWT_SECRET stable or data
# becomes unreadable after rotation unless you also keep this key.
# CONTENT_ENCRYPTION_KEY=
PORT=4000

# Admin console login (separate from user accounts). Password min 8 chars.
# Leave empty to disable admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_admin_password

# Optional production CORS allowlist (comma-separated origins). Empty = allow all.
# CORS_ORIGIN=https://notes.example.com
