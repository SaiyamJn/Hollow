# Builds the Vite SPA, then serves it behind the same Nginx that reverse-proxies
# /api and /socket.io to the backend container.
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Leave unset so the browser calls same-origin /api (proxied by Nginx).
ENV VITE_API_URL=
RUN npm run build

FROM nginx:alpine
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
